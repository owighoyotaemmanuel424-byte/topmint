generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus { ACTIVE SUSPENDED PENDING }
enum AdminRole { SUPER_ADMIN ADMIN SUPPORT }
enum TransactionType { DEPOSIT WITHDRAWAL INVESTMENT RETURN REFUND FEE ADJUSTMENT }
enum TransactionStatus { PENDING PROCESSING COMPLETED FAILED CANCELLED }
enum InvestmentStatus { ACTIVE COMPLETED CANCELLED }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  firstName String?
  lastName String?
  phone String?
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  wallet Wallet?
  investments Investment[]
  transactions Transaction[]
  notifications Notification[]
  auditLogs AuditLog[]
  deposits Deposit[]
  withdrawals Withdrawal[]
  @@index([status])
  @@index([createdAt])
}

model Admin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  role AdminRole @default(ADMIN)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  auditLogs AuditLog[]
  @@index([role])
}

model Wallet {
  id String @id @default(cuid())
  userId String @unique
  balance Decimal @default(0) @db.Decimal(20,2)
  currency String @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger LedgerEntry[]
  @@index([currency])
}

model LedgerEntry {
  id String @id @default(cuid())
  walletId String
  transactionId String?
  amount Decimal @db.Decimal(20,2)
  balanceAfter Decimal @db.Decimal(20,2)
  description String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  @@index([walletId, createdAt])
  @@index([transactionId])
}

model InvestmentPlan {
  id String @id @default(cuid())
  name String
  description String?
  minimumAmount Decimal @db.Decimal(20,2)
  maximumAmount Decimal? @db.Decimal(20,2)
  durationDays Int
  returnRate Decimal @db.Decimal(8,4)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  investments Investment[]
  @@index([active])
}

model Investment {
  id String @id @default(cuid())
  userId String
  planId String
  principal Decimal @db.Decimal(20,2)
  expectedReturn Decimal @db.Decimal(20,2)
  actualReturn Decimal @default(0) @db.Decimal(20,2)
  status InvestmentStatus @default(ACTIVE)
  startedAt DateTime @default(now())
  maturityAt DateTime
  completedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  @@index([userId, status])
  @@index([planId])
  @@index([maturityAt])
}

model Transaction {
  id String @id @default(cuid())
  userId String
  investmentId String?
  reference String @unique
  type TransactionType
  status TransactionStatus @default(PENDING)
  amount Decimal @db.Decimal(20,2)
  currency String @default("NGN")
  description String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]
  deposit Deposit?
  withdrawal Withdrawal?
  @@index([userId, createdAt])
  @@index([type, status])
  @@index([investmentId])
}

model Deposit {
  id String @id @default(cuid())
  userId String
  transactionId String @unique
  provider String?
  providerRef String?
  amount Decimal @db.Decimal(20,2)
  status TransactionStatus @default(PENDING)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([providerRef])
}

model Withdrawal {
  id String @id @default(cuid())
  userId String
  transactionId String @unique
  amount Decimal @db.Decimal(20,2)
  fee Decimal @default(0) @db.Decimal(20,2)
  bankName String?
  accountName String?
  accountNumber String?
  status TransactionStatus @default(PENDING)
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status])
}

model Notification {
  id String @id @default(cuid())
  userId String
  title String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, read, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  adminId String?
  action String
  entity String?
  entityId String?
  metadata Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([entity, entityId])
}
